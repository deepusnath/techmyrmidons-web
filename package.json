{
  "name": "techmyrmidons-web",
  "version": "2.0.0",
  "private": true,
  "description": "TechMyrmidons — follow a Domain Myrmidon and stay current in your field.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "node scripts/validate-content.ts",
    "migrate": "node scripts/migrate-archive.ts",
    "import:observed": "node scripts/import-observed.ts",
    "serve": "node scripts/serve-static.ts",
    "test": "playwright test",
    "test:preview": "npm run build && playwright test",
    "test:production": "npm run build:production && node scripts/check-production-artifacts.ts && DRAFTS_HIDDEN=1 playwright test",
    "test:deployed": "BASE_URL=https://deepusnath.github.io BASE_PREFIX=/techmyrmidons-web playwright test",
    "check:production": "node scripts/check-production-artifacts.ts",
    "deploy": "./scripts/deploy-pages.sh",
    "stamp": "node scripts/stamp-editorial-status.ts",
    "build:production": "NEXT_PUBLIC_SHOW_DRAFTS=false next build",
    "dossiers": "node scripts/build-dossiers.ts",
    "test:rules": "node scripts/tests/rule-isolation.test.ts",
    "test:completion": "node scripts/tests/completion.test.ts"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
